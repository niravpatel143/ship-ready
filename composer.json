{
  "name": "nivoin/ship-ready",
  "description": "Static security, performance, and production-readiness auditor for Laravel 12 and 13",
  "keywords": ["laravel", "security", "audit", "static-analysis", "sarif", "production", "production-readiness"],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/console": "^12.0|^13.0",
    "nikic/php-parser": "^5.0",
    "spatie/laravel-package-tools": "^1.16",
    "symfony/finder": "^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": { "ShipReady\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ShipReady\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["ShipReady\\ShipReadyServiceProvider"]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "pestphp/pest": true
    }
  }
}
