{
  "name": "nivoin/ship-ready",
  "description": "Static security, performance, and production-readiness auditor for Laravel 11, 12, and 13 — 111 checks, MCP server, Octane, Queue, Tenancy, Livewire, Filament, Infrastructure",
  "keywords": ["laravel", "security", "audit", "static-analysis", "sarif", "production", "production-readiness", "security-scanner", "vulnerability-scanner", "performance", "reliability", "code-quality", "pre-deploy", "checklist", "php", "octane", "tenancy", "queue", "filament", "livewire", "mcp"],
  "homepage": "https://github.com/nivoin/ship-ready",
  "license": "MIT",
  "authors": [
    {
      "name": "nivoin",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/console": "^11.0|^12.0|^13.0",
    "nikic/php-parser": "^5.0",
    "spatie/laravel-package-tools": "^1.16",
    "symfony/finder": "^6.0|^7.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0"
  },
  "autoload": {
    "psr-4": { "ShipReady\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "ShipReady\\Tests\\": "tests/" }
  },
  "extra": {
    "laravel": {
      "providers": ["ShipReady\\ShipReadyServiceProvider"]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "pestphp/pest": true
    }
  }
}
